{
  "name": "steam-game-name-zh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "starlight watch",
    "build": "starlight pack --release",
    "prepare": "starlight lsp",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:catalog": "tsx scripts/validate-catalog.ts data/translations.zh-CN.json",
    "check": "pnpm run typecheck && pnpm run test && pnpm run validate:catalog",
    "package": "tsx scripts/package-release.ts"
  },
  "devDependencies": {
    "@steambrew/starlight": "1.1.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "ajv": "8.17.1",
    "fflate": "0.8.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}